{
  "name": "Story World Tracker",
  "short_name": "Story World",
  "description": "Where is everyone in your story? Characters, places, timeline, map and manuscript.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fbfaf7",
  "theme_color": "#b5562c",
  "icons": [
    { "src": "icon-256.png", "sizes": "256x256", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/octet-stream": [".world"] } }
  ]
}
